        dist.disabled = false;
        uzbLocations[reg].forEach(d => {
            const opt = document.createElement('option');
            opt.value = d; 
            opt.innerText = d;
            dist.appendChild(opt);
        });
    } else {
        dist.disabled = true;
        dist.innerHTML = '<option value="">Avval viloyatni tanlang</option>';
    }
}

async function handleGoogleLogin(response) {
    try {
        const res = await fetch('/api/auth/google', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'x-csrf-token': document.querySelector('meta[name="csrf-token"]')?.content || '' },
            body: JSON.stringify({ credential: response.credential })
        });
        const data = await res.json();
        
        if (data.success) {
            if (data.requireDetails) {
                document.getElementById('googleDetailsModal').style.display = 'flex';
            } else {
                window.location.href = '/dashboard';
            }
        } else {
            alert('Xatolik: ' + (data.message || 'Noma\'lum xato'));
        }
    } catch (err) { console.error(err); }
}

async function submitGoogleDetails() {
    const region = document.getElementById('gRegion').value;
    const district = document.getElementById('gDistrict').value;
    const telegram = document.getElementById('gTelegram').value;
    
    if(!region || !district || !telegram) return alert("Iltimos, barcha maydonlarni to'ldiring");
    
    // Viloyat va tumanni birlashtirib bazaga yuboramiz
    const locationStr = `${region}, ${district}`;

    const res = await fetch('/api/auth/google/complete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-csrf-token': document.querySelector('meta[name="csrf-token"]')?.content || '' },
        body: JSON.stringify({ location: locationStr, telegram })
    });
    
    const data = await res.json();
    if(data.success) window.location.href = '/dashboard';
    else alert(data.message);
}
</script>
